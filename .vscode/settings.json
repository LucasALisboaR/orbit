{
    "java.compile.nullAnalysis.mode": "automatic",
    "tailwindCSS.experimental.configFile": "front-end-orbit/src/styles.scss",
    "files.associations": {
        "*.css": "tailwindcss",
        "*.scss": "tailwindcss"
    },
    "editor.quickSuggestions": {
        "strings": true
    },
    "tailwindCSS.classAttributes": [
        "class",
        "className",
        "ngClass",
        "host"
    ]
}